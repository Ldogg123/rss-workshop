# RSS Workshop configuration. Copy to .env, then: chmod 600 .env
#
# Compose reads this file automatically. A native run does not: export the
# values instead. Every setting here has a working default except the admin
# password. See docs/deployment.md for the full reference.


# ─── Required ────────────────────────────────────────────────────────────────

# Your admin password. There is no default and no account to create; the server
# refuses to start without this. Single-quote it if it contains $ or #.
ADMIN_PASSWORD=

# Alternatively supply a bcrypt hash and leave ADMIN_PASSWORD blank.
# Single-quote hashes so Compose preserves their $ signs.
ADMIN_PASSWORD_HASH=

# The address readers and your browser use, with no trailing path. Feed URLs are
# built from it, and management requests are rejected unless the browser's
# Origin matches, so behind a reverse proxy this must be the public HTTPS origin
# such as https://rss.example.net. See docs/reverse-proxy.md.
PUBLIC_BASE_URL=http://localhost:8080


# ─── Storage ─────────────────────────────────────────────────────────────────

# Host directory mounted at /data. Create it before first startup; the container
# runs unprivileged and will not create it, so a typo cannot silently start a
# fresh database:
#   sudo mkdir -p -m 700 ./data && sudo chown 65532:65532 ./data
RSS_DATA_DIR=./data

# Retained stories per feed, 1-10,000. This applies to stories already saved, so
# lowering it permanently deletes the excess at each feed's next refresh.
MAX_ITEMS=500

# Blank keeps SQLite in RSS_DATA_DIR. An explicit postgres:// or postgresql://
# URI selects PostgreSQL; changing this never migrates existing data.
DATABASE_URL=

# Required only with compose.postgres.yaml. Use a unique random password and put
# its URI-encoded equivalent in DATABASE_URL; see docs/postgresql.md.
#   python3 -c 'import secrets; print(secrets.token_hex(24))'
POSTGRES_PASSWORD=

# Host PostgreSQL directory (that override only). Create it before startup:
#   sudo install -d -m 755 ./postgres-data
POSTGRES_DATA_DIR=./postgres-data


# ─── Fetching ────────────────────────────────────────────────────────────────

# Concurrent refreshes, and how long any single fetch may take.
STATIC_WORKERS=16
FETCH_TIMEOUT=30s

# Concurrent Chromium jobs, for pages that need JavaScript. The lightweight
# compose.static.yaml runtime has no Chromium and ignores this.
BROWSER_SLOTS=2

# Sources are reached over the public internet only. To scrape something on your
# own network, name it explicitly, for example 192.168.1.20/32. Blank blocks all
# private and loopback ranges, which is what you want unless you need otherwise.
ALLOW_CIDRS=


# ─── Logs and monitoring ─────────────────────────────────────────────────────

# What reaches `docker compose logs`: debug, info, warn or error. info reports
# startup, sign-ins and each refresh; warn reports only problems. Use json to
# ship logs to a collector. See docs/operations.md#log-detail.
LOG_LEVEL=info
LOG_FORMAT=text

# Docker keeps container logs until the disk fills. These cap each service at
# LOG_MAX_FILES rotated files of LOG_MAX_SIZE, so 10m x 3 is 30 MiB per service.
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

# Optional Prometheus metrics at /metrics. Blank disables the endpoint entirely.
# Scrapers send this as a bearer token. Metrics name your feeds, so keep it
# secret. Generate with:
#   python3 -c 'import secrets; print(secrets.token_hex(24))'
METRICS_TOKEN=


# ─── Optional integrations ───────────────────────────────────────────────────

# Registry image. Blank follows the latest stable browser image (:latest, also
# :latest-browser), or :latest-static with compose.static.yaml. Set an explicit
# tag or digest to pin a version; it must match the selected runtime. Updates
# require docker compose up; they are never automatic.
#   RSS_IMAGE=ghcr.io/ldogg123/rss-workshop:v1.0.0-browser
RSS_IMAGE=

# Existing Docker network shared with a containerized reverse proxy
# (compose.proxy.yaml; docs/reverse-proxy.md). Create it before starting.
PROXY_NETWORK=proxy

# Existing Gluetun container to route through (compose.gluetun.yaml;
# docs/gluetun.md). Publish this internal port on Gluetun, not on RSS Workshop,
# and change it if another container sharing Gluetun already uses 8080.
GLUETUN_CONTAINER=
GLUETUN_APP_PORT=8080

# Existing FlareSolverr service for Cloudflare challenge pages; use its base URL
# or /v1 endpoint. This is trusted service configuration, separate from the
# source allowlist above. See docs/flaresolverr.md.
FLARESOLVERR_URL=
FLARESOLVERR_TIMEOUT=60s
FLARESOLVERR_SLOTS=1
