# Copy to .env and set your chosen admin password. No default password exists.
ADMIN_PASSWORD=
# Alternatively, use a bcrypt hash. Single-quote hashes in .env to preserve $ signs.
ADMIN_PASSWORD_HASH=
PUBLIC_BASE_URL=http://localhost:8080
# Optional image tag or digest. Blank uses the published v0.1.1 browser image,
# or the v0.1.1 static image when compose.static.yaml is selected.
# Set an explicit tag/digest to pin a version; match the selected runtime.
# RSS_IMAGE=ghcr.io/ldogg123/rss-workshop:v0.1.1-browser
RSS_IMAGE=
# Host directory mounted at /data in Docker. Create it before first startup:
# sudo mkdir -p -m 700 ./data
# sudo chown 65532:65532 ./data
# sudo chmod 700 ./data
# Use the same chosen path in those commands and this setting.
RSS_DATA_DIR=./data
# Blank keeps SQLite in DATA_DIR. Set an explicit postgres:// or postgresql://
# connection URI to use PostgreSQL; changing this never migrates existing data.
DATABASE_URL=
# Required only with compose.postgres.yaml. Use a unique random password and
# put its URI-encoded equivalent in DATABASE_URL; see docs/postgresql.md.
POSTGRES_PASSWORD=
# Host PostgreSQL directory (optional server only). Create it before startup:
# sudo install -d -m 755 ./postgres-data
# The parent must be traversable; PostgreSQL makes 18/docker private and manages
# database ownership inside it.
POSTGRES_DATA_DIR=./postgres-data
STATIC_WORKERS=16
FETCH_TIMEOUT=30s
MAX_ITEMS=500
# Optional explicit destinations, e.g. 192.168.1.20/32. Blank blocks private ranges.
ALLOW_CIDRS=

# Concurrent Chromium jobs in the default Docker deployment.
# The optional compose.static.yaml runtime does not include local Chromium.
BROWSER_SLOTS=2

# Optional existing Gluetun container (compose.gluetun.yaml; docs/gluetun.md).
# Publish this internal port on Gluetun, not RSS Workshop. Change it if another
# container sharing Gluetun already listens on 8080.
GLUETUN_CONTAINER=
GLUETUN_APP_PORT=8080

# Optional existing FlareSolverr service; use its base URL or /v1 endpoint.
# This is trusted service configuration, separate from source ALLOW_CIDRS.
FLARESOLVERR_URL=
FLARESOLVERR_TIMEOUT=60s
FLARESOLVERR_SLOTS=1
